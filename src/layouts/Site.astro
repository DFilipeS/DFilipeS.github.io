---
const { title, description, article = false } = Astro.props;
---
<!doctype html>
<html lang="en"><head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="description" content={description}>
<meta name="robots" content="noindex, nofollow">
<meta name="color-scheme" content="light dark">
<title>{title} — Daniel Silva</title>
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='8' fill='%23fafbfc'/%3E%3Ctext x='10' y='46' font-family='Arial' font-size='48' fill='%23305c9c'%3Ed%3C/text%3E%3C/svg%3E">
<script is:inline>
try {
  const theme = localStorage.getItem('color-theme');
  if (['light', 'dark', 'system'].includes(theme)) document.documentElement.dataset.theme = theme;
} catch {}
</script>
<link rel="stylesheet" href="/style.css">
<script is:inline src="/theme.js" defer></script>
</head><body>
<a class="skip" href="#main">Skip to content</a>
<div class:list={["shell", { "article-shell": article }]}><header class="site-header">
<a class="brand" href="/" aria-label="Daniel Silva, home">Daniel Silva<span>.</span></a>
<nav class="main-nav" aria-label="Main navigation"><a href="/#writing">Writing</a><a href="/#speaking">Speaking</a></nav>
<fieldset class="theme-switch" aria-label="Color theme"><legend class="sr-only">Color theme</legend>
<label title="Light theme"><input type="radio" name="theme" value="light" aria-label="Light"><span aria-hidden="true"><svg class="theme-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" focusable="false"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42"/></svg></span><span class="sr-only">Light</span></label>
<label title="Dark theme"><input type="radio" name="theme" value="dark" aria-label="Dark"><span aria-hidden="true"><svg class="theme-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" focusable="false"><path d="M20.9 13.1A9 9 0 0 1 10.9 3.1a9 9 0 1 0 10 10Z"/></svg></span><span class="sr-only">Dark</span></label>
<label title="System theme"><input type="radio" name="theme" value="system" aria-label="System" checked><span aria-hidden="true"><svg class="theme-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" focusable="false"><rect x="3" y="4" width="18" height="13" rx="2"/><path d="M12 17v4m-4 0h8"/></svg></span><span class="sr-only">System</span></label>
</fieldset>
</header>
<main id="main"><slot /></main>
<footer class="footer"><p class="footer-note">A personal corner of the internet.<br>Writing, talks, and things I’m figuring out.</p><nav class="social-links" aria-label="Social links"><a href="https://github.com/DFilipeS">GitHub ↗</a><a href="https://x.com/DFilipeS">X ↗</a><a href="https://www.linkedin.com/in/dfilipes">LinkedIn ↗</a></nav></footer></div></body></html>
